generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
}

enum QueenStatus {
  PRESENT
  ABSENT
  UNKNOWN
}

enum ColonyStatus {
  STRONG
  MODERATE
  WEAK
  INACTIVE
}

enum ProductionCycleStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum HoneyQuality {
  STANDARD
  PREMIUM
}

enum HoneyBatchStatus {
  AVAILABLE
  DEPLETED
  BLOCKED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Tenant {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  slug             String            @unique
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  users            User[]
  apiaries         Apiary[]
  hives            Hive[]
  productionCycles ProductionCycle[]
  honeyBatches     HoneyBatch[]
  orders           Order[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  email        String
  passwordHash String   @map("password_hash")
  role         UserRole @default(OPERATOR)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Apiary {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  location    String
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hives       Hive[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("apiaries")
}

model Hive {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  apiaryId         String            @map("apiary_id") @db.Uuid
  code             String
  queenStatus      QueenStatus       @default(UNKNOWN) @map("queen_status")
  colonyStatus     ColonyStatus      @default(MODERATE) @map("colony_status")
  installationDate DateTime          @map("installation_date") @db.Date
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiary           Apiary            @relation(fields: [apiaryId, tenantId], references: [id, tenantId], onDelete: Cascade)
  productionCycles ProductionCycle[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, apiaryId])
  @@index([tenantId, colonyStatus])
  @@map("hives")
}

model ProductionCycle {
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @map("tenant_id") @db.Uuid
  hiveId                String                @map("hive_id") @db.Uuid
  startDate             DateTime              @map("start_date") @db.Date
  endDate               DateTime?             @map("end_date") @db.Date
  status                ProductionCycleStatus @default(PLANNED)
  estimatedProductionKg Decimal?              @map("estimated_production_kg") @db.Decimal(10, 2)
  actualProductionKg    Decimal?              @map("actual_production_kg") @db.Decimal(10, 2)
  notes                 String?
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hive                  Hive                  @relation(fields: [hiveId, tenantId], references: [id, tenantId], onDelete: Cascade)
  honeyBatches          HoneyBatch[]

  @@unique([id, tenantId])
  @@index([tenantId, hiveId])
  @@index([tenantId, status])
  @@map("production_cycles")
}

model HoneyBatch {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  productionCycleId   String           @map("production_cycle_id") @db.Uuid
  code                String
  productionDate      DateTime         @map("production_date") @db.Date
  quantityKg          Decimal          @map("quantity_kg") @db.Decimal(10, 2)
  availableQuantityKg Decimal          @map("available_quantity_kg") @db.Decimal(10, 2)
  quality             HoneyQuality
  status              HoneyBatchStatus @default(AVAILABLE)
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productionCycle     ProductionCycle  @relation(fields: [productionCycleId, tenantId], references: [id, tenantId], onDelete: Restrict)
  orderItems          OrderItem[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, productionCycleId])
  @@index([tenantId, status])
  @@map("honey_batches")
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  customerName     String      @map("customer_name")
  customerDocument String      @map("customer_document")
  status           OrderStatus @default(PENDING)
  total            Decimal     @db.Decimal(12, 2)
  createdAt        DateTime    @default(now()) @map("created_at")
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items            OrderItem[]

  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@map("orders")
}

model OrderItem {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  orderId      String     @map("order_id") @db.Uuid
  honeyBatchId String     @map("honey_batch_id") @db.Uuid
  quantityKg   Decimal    @map("quantity_kg") @db.Decimal(10, 2)
  unitPrice    Decimal    @map("unit_price") @db.Decimal(10, 2)
  subtotal     Decimal    @db.Decimal(12, 2)
  order        Order      @relation(fields: [orderId, tenantId], references: [id, tenantId], onDelete: Cascade)
  honeyBatch   HoneyBatch @relation(fields: [honeyBatchId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([orderId, honeyBatchId])
  @@index([tenantId, orderId])
  @@index([tenantId, honeyBatchId])
  @@map("order_items")
}
